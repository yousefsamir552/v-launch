# ---------------------------------------------------------------------------
# Cloudflare R2 (image storage)
# Images are stored in R2 and only their public URLs are saved in PostgreSQL.
# Copy these values into the real backend/.env (never commit .env).
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public access URL of the bucket, without a trailing slash.
# Either the r2.dev development URL (https://pub-xxxxxxxx.r2.dev) or a custom domain.
R2_PUBLIC_BASE_URL=

# Initial password for the emergency `sudo` account, used only when the account
# is created for the first time. Leave empty to create it without a usable
# password, then set it here (or change it from the settings screen) later.
SUDO_INITIAL_PASSWORD=

# Optional overrides.
R2_REGION=auto
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_IMAGE_MAX_UPLOAD_BYTES=10485760
# R2_IMAGE_TARGET_BYTES=2097152
# R2_IMAGE_MAX_DIMENSION=3200
